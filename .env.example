# Copy this file to ".env" and fill in real values. Do NOT commit ".env".

# Neon Postgres connection strings:
#   DATABASE_URL = the POOLED connection string (host contains "-pooler")
#   DIRECT_URL   = the DIRECT connection string (no "-pooler"), used for migrations/seeding
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret used to sign auth tokens (JWT). Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-secret"

# Password for the /admin dashboard (view members & stats). Choose a strong value.
ADMIN_KEY="change-this-admin-password"

# Email sending for password reset (Resend — https://resend.com).
# Without these, password reset shows a "contact support" message instead of emailing.
RESEND_API_KEY=""
# The "From" address. Use a verified domain in Resend for production deliverability.
EMAIL_FROM="NaijaArtisans <noreply@naijaartisans.com>"

# Public canonical site URL — drives all SEO URLs (sitemap, robots, Open Graph, JSON-LD).
# Set this in Vercel to your live domain. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://naijaartisans.com"

# ---- Monetization (all optional; features stay hidden until set) ----

# Google AdSense publisher id, e.g. "ca-pub-0000000000000000".
# Leave empty until AdSense approves your site — no ads load without it.
NEXT_PUBLIC_ADSENSE_CLIENT=""
# An ad-unit "slot" id from AdSense (the number on an <ins> ad unit).
NEXT_PUBLIC_ADSENSE_SLOT=""

# Paystack Payment Links for the pricing plans (Phase 1, no backend needed).
# Create them in your Paystack dashboard → Payment Pages, then paste the URLs.
# If empty, the plan buttons fall back to a WhatsApp enquiry.
NEXT_PUBLIC_PAYSTACK_FEATURED_LINK=""
NEXT_PUBLIC_PAYSTACK_PRO_LINK=""

# Paystack API keys (Phase 2 — automated featured listings & subscriptions).
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_xxx"
# PAYSTACK_SECRET_KEY="sk_live_xxx"
