# Copy this file to ".env" and fill in real values. Do NOT commit ".env".

# Neon Postgres connection strings:
#   DATABASE_URL = the POOLED connection string (host contains "-pooler")
#   DIRECT_URL   = the DIRECT connection string (no "-pooler"), used for migrations/seeding
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret used to sign auth tokens (JWT). Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-secret"

# Public canonical site URL — drives all SEO URLs (sitemap, robots, Open Graph, JSON-LD).
# Set this in Vercel to your live domain. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://naijaartisans.com"
