// NaijaArtisans data model
// Switch `provider` to "postgresql" (and update DATABASE_URL) to deploy on Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used at runtime)
  directUrl = env("DIRECT_URL") // direct connection (used for migrations / db push)
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  phone       String?  @unique
  password    String
  role        String   @default("CUSTOMER") // CUSTOMER | ARTISAN
  city        String?
  bio         String?
  avatarUrl   String?
  galleryUrls String[] @default([]) // artisan work / portfolio photos
  createdAt   DateTime @default(now())
  /// Maintained by Prisma on every write. Exists so the sitemap can publish a
  /// truthful <lastmod> for /artisans/<id> instead of inventing "now".
  updatedAt   DateTime @default(now()) @updatedAt

  /// Denormalised review aggregates, recomputed by recomputeArtisanRating() in
  /// src/lib/reviews.js whenever a review is written. /browse renders one card per
  /// service, so reading these as plain columns is what keeps that page free of a
  /// per-artisan aggregate query.
  ///
  /// GENUINE REVIEWS ONLY — demo/seed reviews (Review.isDemo) are excluded, so a
  /// seeded staging database can never show an inflated public rating.
  ratingAverage Float?
  reviewCount   Int    @default(0)

  /// Deals this artisan finished AND the customer confirmed. Denormalised for
  /// the same reason as reviewCount: /browse renders up to 60 cards, and an
  /// aggregate per card would be 60 extra queries.
  ///
  /// CUSTOMER-CONFIRMED ONLY. An artisan marking their own work done moves the
  /// deal to AWAITING_CONFIRMATION, which is not counted here. That is the whole
  /// point of the number: the artisan cannot award it to themselves.
  /// Recomputed by recomputeCompletedDeals() in src/lib/deals.js on every change.
  completedDealCount Int @default(0)

  // Monetization & growth
  featuredUntil DateTime? // artisan shows at the top with a badge while in the future
  proUntil      DateTime? // active Pro subscription expiry
  referredById  String? // the artisan who invited this user

  // Geolocation captured at signup (with the user's permission)
  latitude  Float?
  longitude Float?

  // Business hours (optional, "HH:MM" 24h)
  openTime  String?
  closeTime String?

  // Password reset (hashed token + expiry)
  resetTokenHash   String?
  resetTokenExpiry DateTime?

  services      Service[]
  jobRequests   JobRequest[]   @relation("CustomerJobs")
  quotes        Quote[]
  reviewsGiven  Review[]       @relation("ReviewAuthor")
  reviewsGot    Review[]       @relation("ReviewTarget")
  payments      Payment[]
  /// Done-for-you orders placed by this user. Optional on the order side:
  /// buying does not require an account.
  serviceOrders ServiceOrder[] @relation("CustomerOrders")

  notifications Notification[]

  dealsAsCustomer Deal[] @relation("CustomerDeals")
  dealsAsArtisan  Deal[] @relation("ArtisanDeals")

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrals")

  /// Artisan matching filters on role + city on every job post.
  @@index([role, city])
}

model Payment {
  id        String   @id @default(cuid())
  reference String   @unique // Paystack transaction reference
  plan      String // "featured" | "pro"
  amount    Int // kobo
  status    String   @default("success")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Category {
  id   String  @id @default(cuid())
  name String  @unique
  slug String  @unique
  icon String?

  services    Service[]
  jobRequests JobRequest[]
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  priceMin    Int?
  priceMax    Int?
  city        String
  createdAt   DateTime @default(now())
  /// Source of <lastmod> for the /services/<category>/<city> money pages.
  updatedAt   DateTime @default(now()) @updatedAt

  artisan    User     @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId  String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  @@index([categoryId])
  @@index([city])
  /// The /services/<category>/<city> query filters on both at once.
  @@index([categoryId, city])
  @@index([artisanId])
}

model JobRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  city        String
  budget      Int?
  /// OPEN            on the board, artisans may quote
  /// IN_PROGRESS     a quote was accepted; a Deal is running
  /// COMPLETED       the customer confirmed the work was done
  /// CLOSED          withdrawn by the customer without a completed deal
  ///
  /// Only OPEN jobs are broadcast to artisans, so accepting a quote takes the
  /// job off the alert list automatically.
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  customer      User           @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  categoryId    String
  quotes        Quote[]
  reviews       Review[]
  deals         Deal[]
  notifications Notification[]

  @@index([categoryId])
  @@index([city])
  /// Matching reads OPEN jobs by category+city; the board reads newest-first.
  @@index([categoryId, city])
  @@index([status, createdAt])
  @@index([customerId])
}

model Quote {
  id        String   @id @default(cuid())
  message   String
  price     Int?
  createdAt DateTime @default(now())

  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  jobRequestId String
  artisan      User       @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId    String

  /// Set once the customer accepts this quote.
  deal Deal?

  @@unique([jobRequestId, artisanId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  /// The job this review came out of. Nullable because rows written before review
  /// eligibility existed have no job to point at; new reviews always set it.
  /// SetNull rather than Cascade — deleting a job must not erase an artisan's record.
  jobRequest   JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  jobRequestId String?

  /// The completed deal this review came out of, when there was one. A review
  /// with a deal is rendered as "Verified job" — it is backed by work the
  /// customer confirmed, not merely by contact. Nullable because a customer who
  /// dealt with an artisan off-platform can still review them.
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId String? @unique

  /// TRUE only for synthetic rows created by `npm run seed:demo`. Demo reviews are
  /// excluded from ratingAverage/reviewCount and are labelled wherever they render,
  /// so they can never be mistaken for genuine customer activity.
  isDemo Boolean @default(false)

  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId String

  /// One review per customer per artisan. This is the duplicate-prevention
  /// guarantee; the API check in front of it is only there for a nicer error.
  @@unique([authorId, targetId])
  /// Every read is "newest reviews for this artisan".
  @@index([targetId, createdAt])
  @@index([jobRequestId])
  @@index([authorId])
}

/// In-app notification, and the record of whether its email went out.
///
/// One table serves both channels deliberately: the in-app inbox and the email are
/// the same event, and splitting them is how the two drift apart. Push/SMS can be
/// added later as extra status columns without touching callers.
model Notification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type  String // NEW_JOB_MATCH | NEW_QUOTE
  title String
  body  String
  /// Deep link the artisan should land on, e.g. /jobs/<id>.
  url   String

  jobRequest   JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  jobRequestId String?

  /// Idempotency key, e.g. "job:<jobId>:artisan:<userId>". A retried job POST
  /// re-runs createMany({ skipDuplicates: true }), so this unique constraint —
  /// not application logic — is what guarantees one notification per artisan per job.
  dedupeKey String @unique

  readAt DateTime?

  /// Delivery is tracked per row so a Resend outage is visible and retryable
  /// instead of silently swallowed.
  emailStatus   String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  emailAttempts Int       @default(0)
  emailError    String?
  emailSentAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([jobRequestId])
  @@index([emailStatus, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DONE-FOR-YOU  —  NaijaArtisans sells the work, then has it delivered.
//
// This is a different business from the directory above. There, artisans pay us
// to be found and the job money never touches the platform. Here WE are the
// seller: the customer buys a fixed-price package from NaijaArtisans, we assign
// someone to deliver it, and we keep the spread.
//
// The consequence is worth stating plainly, because it drives every field below:
// once we take the money we own the outcome. So an order records what we charged
// AND what we expect delivery to cost, who is doing it, and when it is due.
//
// All money is in KOBO, matching the existing Payment model. Fields are suffixed
// `Kobo` so there is never a doubt.
// ─────────────────────────────────────────────────────────────────────────────

model ServicePackage {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  summary     String // one line, used on the catalogue card
  description String

  /// Free-text rather than a Category relation: those categories drive the
  /// artisan directory's navigation, and adding "Logo Design" to them would put
  /// it in the plumbers-and-carpenters menu.
  category String

  /// DIGITAL ships as a file and can be checked from anywhere. PHYSICAL means
  /// someone turns up at an address, which we cannot inspect remotely — kept in
  /// the model so trades can be switched on later, but not sold yet.
  kind String @default("DIGITAL") // DIGITAL | PHYSICAL

  priceKobo  Int
  /// Share of the price taken before work starts.
  depositPct Int @default(50)
  /// What we expect to pay the deliverer. Never rendered publicly.
  costKobo   Int

  turnaroundDays Int
  revisions      Int      @default(2)
  deliverables   String[] @default([]) // what the customer receives
  requirements   String[] @default([]) // what we need from them to start

  /// Nothing is sellable until switched on deliberately.
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  orders ServiceOrder[]

  @@index([kind, isActive])
}

model ServiceOrder {
  id        String @id @default(cuid())
  /// Short human code the customer quotes in emails, e.g. NA-2609-4F2A.
  reference String @unique

  package   ServicePackage @relation(fields: [packageId], references: [id])
  packageId String

  /// Buying does not require an account — a checkout that demands registration
  /// loses the sale.
  customer      User?   @relation("CustomerOrders", fields: [customerId], references: [id])
  customerId    String?
  customerName  String
  customerEmail String
  customerPhone String?

  /// The customer's answers to the package's `requirements`, stored as JSON so a
  /// package can change its questions without a migration.
  briefJson String @default("{}")

  // AWAITING_DEPOSIT | IN_PROGRESS | DELIVERED | AWAITING_BALANCE | COMPLETED
  //                  | CANCELLED | REFUNDED
  status String @default("AWAITING_DEPOSIT")

  /// Snapshotted at purchase. A later price change must never alter what someone
  /// already agreed to pay.
  priceKobo   Int
  depositKobo Int
  balanceKobo Int
  costKobo    Int

  // ── fulfilment ────────────────────────────────────────────────────────────
  fulfillerType     String? // PLATFORM_ARTISAN | EXTERNAL
  fulfillerUserId   String? // set when a registered artisan is doing it
  fulfillerName     String?
  fulfillerNote     String?
  /// What we actually agreed to pay, which may differ from the package estimate.
  fulfillerCostKobo Int?
  fulfillerPaidAt   DateTime?

  dueAt       DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments   ServicePayment[]
  deliveries Delivery[]

  @@index([status])
  @@index([createdAt])
}

/// Kept separate from `Payment` so subscription revenue and order revenue never
/// have to be untangled in a report.
model ServicePayment {
  id        String @id @default(cuid())
  reference String @unique // Paystack transaction reference

  order   ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  kind       String // DEPOSIT | BALANCE
  amountKobo Int
  feeKobo    Int       @default(0)
  status     String    @default("PENDING") // PENDING | PAID | FAILED
  paidAt     DateTime?
  rawJson    String    @default("{}")
  createdAt  DateTime  @default(now())

  @@index([orderId])
}

model Delivery {
  id        String       @id @default(cuid())
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  note      String?
  fileUrls  String[]     @default([])
  /// False until the customer accepts it; a revision request flips it back.
  accepted  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([orderId])
}

/// A transaction between one customer and one artisan: the record of work being
/// done, and the source of the public "X jobs completed" badge.
///
/// ── WHY THIS TABLE EXISTS ─────────────────────────────────────────────────
///
/// Before it, the marketplace could show that an artisan had been *contacted*
/// (a quote) but never that they had *delivered*. A customer choosing between
/// two plumbers had stars from nobody and no completion history, so the only
/// available signal was who paid to be Featured.
///
/// ── WHY THE ARTISAN CANNOT COMPLETE THEIR OWN DEAL ────────────────────────
///
/// The artisan moves the deal to AWAITING_CONFIRMATION; only the customer can
/// move it to COMPLETED, and only COMPLETED increments completedDealCount. The
/// full reasoning, and the state machine itself, is in src/lib/deal-rules.js.
model Deal {
  id String @id @default(cuid())

  /// The job this came out of. Nullable so a deal can later be opened without a
  /// job posting; every deal today has one.
  jobRequest   JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  jobRequestId String?

  /// The accepted quote. One quote can only ever become one deal.
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteId String? @unique

  customer   User   @relation("CustomerDeals", fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  artisan    User   @relation("ArtisanDeals", fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId  String

  /// IN_PROGRESS | AWAITING_CONFIRMATION | COMPLETED | CANCELLED
  status String @default("IN_PROGRESS")

  /// What the two sides agreed, in naira, snapshotted from the quote. Matches
  /// the units of Quote.price and JobRequest.budget (NOT kobo, unlike Payment).
  agreedPrice Int?

  /// A short description of the work, copied from the job at acceptance so the
  /// deal still reads correctly if the job is later edited or deleted.
  title String

  startedAt   DateTime  @default(now())
  /// When the artisan said the work was finished. Counts for nothing on its own.
  workDoneAt  DateTime?
  /// When the CUSTOMER confirmed. This is the timestamp the badge is built from.
  completedAt DateTime?
  cancelledAt DateTime?
  /// "customer" or "artisan" — who called it off, for support conversations.
  cancelledBy String?

  /// Free-text note from whoever last moved the deal, shown to the other side.
  lastNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  /// One deal per artisan per job: accepting the same quote twice must not
  /// create a second completable deal, which would double-count the badge.
  @@unique([jobRequestId, artisanId])
  /// "my deals" for either side, and the completed-count recompute.
  @@index([artisanId, status])
  @@index([customerId, status])
  @@index([status, completedAt])
}

// Marketing leads captured by the opt-in lead magnets (not full accounts yet).
model Lead {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  email     String?
  trade     String? // category / profession (free text for a lead)
  city      String?
  side      String   @default("ARTISAN") // ARTISAN | CUSTOMER
  source    String? // where it was captured
  magnet    String? // which lead magnet
  createdAt DateTime @default(now())

  @@index([side])
  @@index([createdAt])
}
